# Copiá este archivo a .env y completá tus API keys.
# main.py salta automáticamente cualquier proveedor cuya key falte.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: override de modelo por proveedor.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama corre local, no usa API key -- por eso no hay OLLAMA_API_KEY acá.
# Se intenta siempre; si `ollama serve` no está corriendo, el error de
# conexión queda controlado igual que cualquier otro proveedor caído.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

